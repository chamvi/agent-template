# Local development only. Never deploy the shared sample token.
PORT=3000
HOST=127.0.0.1
TOKENS='[{"value":"change-me-dev-token-0001","id":"dev","permissions":"*"}]'
# Required for the example agent. Fill this in your ignored .env.
ANTHROPIC_API_KEY=

# Models: an agent names '<provider>/<model id>' or inherits MODEL.
# ANTHROPIC_API_KEY alone creates the provider "anthropic"; a declared provider of that name replaces it.
# MODEL=anthropic/claude-sonnet-5-5
# A named provider with its own key, used as 'team-a/<model id>':
# PROVIDER_TEAM_A_TYPE=anthropic
# PROVIDER_TEAM_A_API_KEY=
# A self-hosted OpenAI-compatible router (install @ai-sdk/openai-compatible), used as 'router/<model id>':
# PROVIDER_ROUTER_TYPE=openai-compatible
# PROVIDER_ROUTER_BASE_URL=http://localhost:20128/v1
# The same settings from a file (default ./chamvi.json when it exists; env wins over it):
# CONFIG_FILE=./chamvi.json

# Durable storage (unset uses in-memory storage, lost on restart).
# DATABASE_URL=postgres://chamvi:change-me@localhost:5432/chamvi
# With DATABASE_URL every start migrates; false leaves migrations to `chamvi migrate`.
# MIGRATE=false

# Public origin only. The approval link builder adds BASE_PATH once.
# PUBLIC_URL=http://localhost:3000
# BASE_PATH=/api

# Run cron subscriptions in this process. Disable when external CronJobs fire them.
# SCHEDULER=true
# DRAIN_TIMEOUT_MS=30000
# READINESS_DELAY_MS=0
# CLOSE_TIMEOUT_MS=5000
# FORCE_EXIT_MS=90000

# Optional folder agents, alongside the explicit src/index.ts app entry.
# AGENTS_DIR=./agents
# AGENTS_POLL_MS=5000
# Optional package agents (chamvi 0.5.1): installed npm packages that default-export agents, comma-separated.
# A package agent's revision is its version: the first start after a bump cancels its unsettled runs.
# AGENTS=@acme/review-agent,@acme/digest-agent

# Optional GitHub module: signed intake at /channels/github.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_SLUG=

# Needed once the dashboard saves a connection (settings-only ones too), and for the WhatsApp module: the keyring that
# encrypts stored connection secrets and sessions, <id>:<base64 32-byte key>[,...], the first active.
# ENCRYPTION_KEYS=

# Optional outbound OpenClaw channel: use a concrete channel and destination.
# OPENCLAW_BASE_URL=
# OPENCLAW_HOOKS_TOKEN=
# OPENCLAW_CHANNEL=
# OPENCLAW_TO=

# Optional sandbox module (also install the selected provider package).
# SANDBOX_PROVIDER=kubernetes
# SANDBOX_NAMESPACE=sandboxes
# SANDBOX_IMAGE=ghcr.io/chamvi/sandbox-dev:trixie
# Images the model may pick in create_workspace (comma list, exact references; unset: none).
# SANDBOX_IMAGES=python:3.13,rust:1
# Suspend the workspace of a run waiting longer than this (ms, default 30 min; 0 turns it off).
# SANDBOX_SUSPEND_AFTER_MS=1800000
# Kubernetes: keep /workspace and /home/sandbox on a claim per workspace, so a suspended pod can be rebuilt
# (the sandbox Role then needs persistentvolumeclaims create/get/list/delete; unset storage class: cluster default).
# SANDBOX_PERSISTENCE=true
# SANDBOX_STORAGE_CLASS=standard
# Docker: stop the container of a suspended workspace and restart it on resume (loses /tmp and background jobs).
# SANDBOX_DOCKER_SUSPEND=true
# One name per app when several apps share a Docker host or namespace (label value).
# DEPLOYMENT=my-app
# Tokens for private repositories and pushes (JSON list of { host, path?, username?, token }).
# SANDBOX_GIT_TOKENS=[{"host":"gitlab.example.com","path":"group","token":"..."}]
# Plain git in bash authenticates through the workspace credential helper.
# Sandbox code can read these tokens. Restrict their permissions and enforce branch rules at the forge.
