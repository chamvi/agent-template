# Local development only. Never deploy the shared sample token.
PORT=3000
HOST=127.0.0.1
CHAMVI_TOKENS='[{"value":"change-me-dev-token-0001","id":"dev","permissions":["*"]}]'
# Required for the example agent. Fill this in your ignored .env.
ANTHROPIC_API_KEY=

# Models: an agent names '<provider>/<model id>' or inherits CHAMVI_MODEL.
# ANTHROPIC_API_KEY alone creates the provider "anthropic"; a declared provider of that name replaces it.
# CHAMVI_MODEL=anthropic/claude-sonnet-5-5
# A named provider with its own key, used as 'team-a/<model id>':
# CHAMVI_PROVIDER_TEAM_A_TYPE=anthropic
# CHAMVI_PROVIDER_TEAM_A_API_KEY=
# A self-hosted OpenAI-compatible router (install @ai-sdk/openai-compatible), used as 'router/<model id>':
# CHAMVI_PROVIDER_ROUTER_TYPE=openai-compatible
# CHAMVI_PROVIDER_ROUTER_BASE_URL=http://localhost:20128/v1
# The same settings from a file (default ./chamvi.json when it exists; env wins over it):
# CHAMVI_CONFIG_FILE=./chamvi.json

# Durable storage (unset uses in-memory storage, lost on restart).
# DATABASE_URL=postgres://chamvi:change-me@localhost:5432/chamvi
# With DATABASE_URL every start migrates; false leaves migrations to `chamvi migrate`.
# CHAMVI_MIGRATE=false

# Public origin only. The approval link builder adds CHAMVI_BASE_PATH once.
# CHAMVI_PUBLIC_URL=http://localhost:3000
# CHAMVI_BASE_PATH=/api

# Run cron subscriptions in this process. Disable when external CronJobs fire them.
# CHAMVI_SCHEDULER=true
# CHAMVI_DRAIN_TIMEOUT_MS=30000
# CHAMVI_READINESS_DELAY_MS=0
# CHAMVI_CLOSE_TIMEOUT_MS=5000
# CHAMVI_FORCE_EXIT_MS=90000

# Optional folder agents, alongside the explicit src/index.ts app entry.
# CHAMVI_AGENTS_DIR=./agents
# CHAMVI_AGENTS_POLL_MS=5000

# Optional GitHub module: signed intake at /channels/github.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_SLUG=

# Optional outbound OpenClaw channel: use a concrete channel and destination.
# OPENCLAW_BASE_URL=
# OPENCLAW_HOOKS_TOKEN=
# OPENCLAW_CHANNEL=
# OPENCLAW_TO=

# Optional sandbox module (also install the selected provider package).
# CHAMVI_SANDBOX_PROVIDER=kubernetes
# CHAMVI_SANDBOX_NAMESPACE=sandboxes
# CHAMVI_SANDBOX_IMAGE=ghcr.io/chamvi/sandbox-dev:trixie
# Images the model may pick in create_workspace (comma list, exact references; unset: none).
# CHAMVI_SANDBOX_IMAGES=python:3.13,rust:1
# One name per app when several apps share a Docker host or namespace (label value).
# CHAMVI_DEPLOYMENT=my-app
# Tokens for private repositories and pushes (JSON list of { host, path?, username?, token }).
# CHAMVI_GIT_TOKENS=[{"host":"gitlab.example.com","path":"group","token":"..."}]
# Plain git in bash authenticates through the workspace credential helper.
# Sandbox code can read these tokens. Restrict their permissions and enforce branch rules at the forge.
# workspace: plain git in bash can authenticate (default); tools: only git_fetch/git_pull/git_push can.
# CHAMVI_GIT_CREDENTIAL_MODE=workspace
