# Local development only. Never deploy the shared sample token.
PORT=3000
HOST=127.0.0.1
CHAMVI_TOKENS='[{"value":"change-me-dev-token-0001","id":"dev","permissions":["*"]}]'
# Required for the example agent. Fill this in your ignored .env.
ANTHROPIC_API_KEY=

# Durable storage (unset uses in-memory storage, lost on restart).
# DATABASE_URL=postgres://chamvi:change-me@localhost:5432/chamvi
# With DATABASE_URL every start migrates; false leaves migrations to `chamvi migrate`.
# CHAMVI_MIGRATE=false

# Public origin only. The approval link builder adds CHAMVI_BASE_PATH once.
# CHAMVI_PUBLIC_URL=http://localhost:3000
# CHAMVI_BASE_PATH=/api

# Run cron subscriptions in this process. Disable when external CronJobs fire them.
# CHAMVI_SCHEDULER=true
# CHAMVI_DRAIN_TIMEOUT_MS=30000
# CHAMVI_READINESS_DELAY_MS=0
# CHAMVI_CLOSE_TIMEOUT_MS=5000
# CHAMVI_FORCE_EXIT_MS=90000

# Optional folder agents, alongside the explicit src/index.ts app entry.
# CHAMVI_AGENTS_DIR=./agents
# CHAMVI_AGENTS_POLL_MS=5000

# Optional GitHub module: signed intake at /channels/github.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_SLUG=

# Optional outbound OpenClaw channel: use a concrete channel and destination.
# OPENCLAW_BASE_URL=
# OPENCLAW_HOOKS_TOKEN=
# OPENCLAW_CHANNEL=
# OPENCLAW_TO=

# Optional sandbox module (also install the selected provider package).
# CHAMVI_SANDBOX_PROVIDER=kubernetes
# CHAMVI_SANDBOX_NAMESPACE=sandboxes
# CHAMVI_SANDBOX_IMAGE=ghcr.io/chamvi/sandbox-node:24
